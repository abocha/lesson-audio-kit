# OpenAI API Key - REQUIRED for TTS generation
OPENAI_API_KEY=

# ElevenLabs API Key - Optional, for ElevenLabs TTS
ELEVEN_KEY=

# Fal.ai API Key - Optional, for Fal.ai TTS
FAL_KEY=

# Path to SQLite database for usage tracking - Optional
DB_PATH=usage.db

# NSFW API URL Template - Optional, for content safety checks
# Example: NSFW_API_URL_TEMPLATE=https://api.example.com/check?text={text}
NSFW_API_URL_TEMPLATE=

# Default TTS model for the application - Optional
# Supported: tts-1, tts-1-hd, gpt-4o-mini-tts
MODEL_DEFAULT=gpt-4o-mini-tts

# Stripe API Key - Optional, for monetization features
STRIPE_KEY=

# Supabase URL - Optional, for monetization/backend features
SUPABASE_URL=

# Supabase Anon Key - Optional, for monetization/backend features
SUPABASE_ANON_KEY=

# Cache Configuration
APP_CACHE_BASE_DIR=.cache/tts_cache # Default path for the audio cache
APP_MAX_CACHE_SIZE_GB=2.0          # Default max cache size in GB
